# ==========================================================================
# SERVER & NETWORK
# ==========================================================================
NODE_ENV=development
PORT=5000

# Base URL of the client application. Used for links in emails (e.g. email verification, password reset, invites).
# Must start with http:// or https:// with no trailing slash (e.g., http://192.168.1.20:5173).
# NOTE: The server MUST be restarted after any change to environment variables.
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed browser origins for CORS access.
# Default: CLIENT_URL plus http://localhost:5173.
# Example for local network demos: http://192.168.1.20:5173,http://localhost:5173
# NOTE: The server MUST be restarted after any change to environment variables.
CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173

# ==========================================================================
# DATABASE (PostgreSQL via Prisma)
# ==========================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consumer_forum_portal?schema=public"

# ==========================================================================
# JWT
# ==========================================================================
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRY=7d

# ==========================================================================
# EMAIL (Nodemailer / SMTP)
# ==========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Gmail: turn on 2-Step Verification, then create an "App password"
# (https://myaccount.google.com/apppasswords) and paste it here WITHOUT spaces.
# Never commit the real values — keep them only in server/.env.
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# Use a full address, e.g. "State Consumer Forum <your_email@gmail.com>" (Gmail rewrites other senders).
EMAIL_FROM="State Consumer Forum <your_email@gmail.com>"

# ==========================================================================
# AI-ASSISTED SYNOPSIS (Feature 2) — LLM_PROVIDER: 'gemini' | 'openai' | 'none'
# If left as 'none' (or the relevant key is blank), a rule-based fallback
# synopsis is used instead so the feature still works without live keys.
# ==========================================================================
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==========================================================================
# SMS GATEWAY (Feature 4 — Notice Delivery Tracker)
# Leave blank to log SMS instead of sending (safe for local dev/demo).
# ==========================================================================
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=SCFRUM

# ==========================================================================
# FILE UPLOAD
# ==========================================================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ==========================================================================
# RATE LIMITING
# ==========================================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# ==========================================================================
# FRONTEND (Vite)
# ==========================================================================
VITE_API_BASE_URL=http://localhost:5000/api/v1
